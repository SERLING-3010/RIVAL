# Copia este archivo como .env en el servidor y llena los valores. El .env NUNCA va al repositorio.

# Base de datos PostgreSQL (la crea el servicio db la primera vez).
POSTGRES_USER=rival
POSTGRES_PASSWORD=cambia-esto-por-una-clave-larga-y-unica
POSTGRES_DB=rival

# Alcance del lanzamiento (Sprint 29): solo fútbol, sin árbitros y sin establecimientos deportivos.
# Para prender algo más adelante: agrega deportes separados por coma o cambia false por true.
RIVAL_SPORTS=FOOTBALL
RIVAL_ENABLE_REFEREES=false
RIVAL_ENABLE_VENUES=false

# Responsable del tratamiento de datos (Ley 1581): aparece en la Política de privacidad de la app.
# Usa datos de contacto pensados para esto (un correo de privacidad de tu dominio), no los personales.
RIVAL_LEGAL_NAME=
RIVAL_LEGAL_ADDRESS=
RIVAL_LEGAL_EMAIL=
RIVAL_LEGAL_PHONE=
# Quién atiende las solicitudes, p. ej. Equipo de privacidad de RIVAL
RIVAL_LEGAL_ATTENDS=
# Proveedor del servidor, p. ej. DigitalOcean (Estados Unidos)
RIVAL_LEGAL_HOSTING=
# Fecha desde la que rige la política, p. ej. 1 de febrero de 2027
RIVAL_LEGAL_SINCE=

# Orígenes permitidos para el navegador (separados por coma). La app móvil no los necesita.
RIVAL_CORS_ORIGINS=https://rival.example.com

# IP del proxy HTTPS que pasa la IP real del cliente (X-Forwarded-For). Si el proxy corre en el
# mismo servidor y en la red de Docker, suele ser la IP de la puerta de enlace de esa red.
FORWARDED_ALLOW_IPS=127.0.0.1

# Duración de las sesiones, en horas.
RIVAL_SESSION_TTL_HOURS=168
RIVAL_SESSION_IDLE_HOURS=72

# Nunca true en producción: deja expuesta la documentación de la API.
RIVAL_DEBUG=false
